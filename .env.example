# ==============================================================================
# CallPlan Environment Variables (.env)
# ==============================================================================

# Supabase PostgreSQL & Auth (Required for online production & Vercel deployment)
# Dapatkan dari: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Google Maps JavaScript API (Opsional - default menggunakan OpenStreetMap gratis)
# Aktifkan Maps JavaScript API & Geocoding API dengan pembatasan HTTP Referrer
VITE_GOOGLE_MAPS_API_KEY=

# Backend Laravel REST API (Legacy/Transisi - kosongkan jika menggunakan Supabase)
VITE_API_BASE_URL=
